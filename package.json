{
  "name": "blfp-client",
  "version": "2.4.0-pre.9",
  "description": "BLFP - Minecraft Java 联机软件 - 客户端 (Electron + EasyTier + frpc)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js",
    "dist": "node scripts/prepare-release.js && electron-builder",
    "build:payload": "node scripts/build-payload.js"
  },
  "author": "xingyub <160427359@qq.com>",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.blfp.client",
    "productName": "BLFP",
    "directories": {
      "output": "build_v${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "!**/*.map",
      "assets/**"
    ],
    "win": {
      "target": "dir",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "assets/icon.png"
    },
    "asar": false,
    "extraResources": [
      "bin/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "artifactName": "BLFP-v${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "priority": "optional",
      "synopsis": "BLFP Minecraft Java 联机客户端",
      "description": "BLFP - Minecraft Java 联机软件 Linux 客户端，基于 EasyTier 虚拟组网与 6 位房间号。"
    }
  }
}
